# ============================================================================
# MuleTrace: Open Agent Hackathon 2026 (Track 3: Reasoning Architecture)
# Copy to .env for live Zetaris Docker + Meterless Nightshift execution.
# Never commit .env or place raw NVIDIA API keys in this file.
# ============================================================================

# Sample fallback mode (true runs out-of-the-box over data/sample/ via SQLite)
SAMPLE_MODE=true

# Layer 01: DATA (Zetaris Lightning & REST API)
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key-here
ZETARIS_USERNAME=your-sign-in-email
ZETARIS_PASSWORD=your-strong-password

# Layer 03: POWER (Meterless Nightshift Runtime + NVIDIA Nemotron Lanes)
# Configure your NVIDIA API key inside Meterless Nightshift -> Setup -> Providers -> NVIDIA
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token-here
METERLESS_APP_NAME=muletrace-agent
METERLESS_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
METERLESS_DEEP_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Setup Guide Page 24 Official smoke_test.py Aliases
MODEL_BASE_URL=http://127.0.0.1:8088/v1
MODEL_API_KEY=your-nightshift-runtime-token-here
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
